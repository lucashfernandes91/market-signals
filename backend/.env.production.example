DJANGO_SETTINGS_MODULE=core.settings.production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.exemplo.com
CSRF_TRUSTED_ORIGINS=https://api.exemplo.com
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

POSTGRES_DB=market_radar
POSTGRES_USER=market_radar
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

REDIS_PASSWORD=
REDIS_URL=
CACHE_REDIS_URL=
CHANNEL_REDIS_URL=

MARKET_PROVIDER=binance
MARKET_CATALOG_QUOTE_ASSETS=USDT,BRL
MARKET_CATALOG_BASE_ASSETS=
MARKET_CATALOG_EXCLUDED_ASSETS=
MARKET_CATALOG_MAX_PAIRS=0
MARKET_SUBSCRIPTION_RELOAD_SECONDS=60
MARKET_STALE_CHECK_SECONDS=5
MARKET_STALE_AFTER_SECONDS=15
MARKET_CATALOG_SYNC_SECONDS=300

PERSONAL_MODE_ENABLED=false

NOTIFICATION_PROVIDER=fcm
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH_HOST=/etc/market-radar/firebase-service-account.json

SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
STATIC_FILES_DIR=./var/production/staticfiles
APP_VERSION=

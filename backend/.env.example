DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
REDIS_URL=redis://localhost:6380/0
MARKET_PROVIDER=binance
MARKET_CATALOG_QUOTE_ASSETS=USDT
MARKET_CATALOG_BASE_ASSETS=
MARKET_CATALOG_EXCLUDED_ASSETS=
MARKET_CATALOG_MAX_PAIRS=0
BINANCE_REQUEST_TIMEOUT_SECONDS=10
BINANCE_CATALOG_TIMEOUT_SECONDS=120
BINANCE_CATALOG_ENDPOINT=https://api.binance.com/api/v3
MARKET_SUBSCRIPTION_RELOAD_SECONDS=60
MARKET_STALE_CHECK_SECONDS=5
MARKET_STALE_AFTER_SECONDS=15
NOTIFICATION_PROVIDER=stub
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
